{
  "name": "fmrl-mcp",
  "version": "0.17.7",
  "mcpName": "io.github.toogreatwtf/fmrl-mcp",
  "description": "Your agent's outbox. Ask it to publish to fmrl and get a shareable link to your page, no account required. Agents and people can edit and organize canvases together. Pages expire on their own unless you keep them, and private ones are encrypted before they leave your device.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fmrl-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs && node scripts/smoke-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "check:fixtures": "node scripts/check-fixtures.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toogreatwtf/fmrl-plugin.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://fmrl.site/install",
  "keywords": [
    "mcp",
    "fmrl",
    "share",
    "publish"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "marked": "18.1.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "parse5": "^7.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
